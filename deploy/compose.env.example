# Copy these values into a root-level .env file or export them before running
# docker compose. The root .env file is ignored by Git.

# Use strong secrets for any shared environment. These defaults are for local
# development only.
POSTGRES_PASSWORD=change-me
REDIS_PASSWORD=change-me

# Absolute path on the host containing configs/, models/, and data/processed/.
# On Windows, forward slashes work best with Docker Desktop.
RECOMART_ARTIFACT_ROOT=E:/Programming/recomart-recommender-system

POSTGRES_PORT=55432
REDIS_PORT=56379
API_PORT=8000
DEMO_PORT=8501
RECOMART_CACHE_TTL_SECONDS=3600
