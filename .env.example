# Optional serving artifact root; defaults to the repository directory.
# The API reads this environment variable directly, not this file automatically.
# RECOMART_ARTIFACT_ROOT=E:/Programming/recomart-recommender-system

# Optional PostgreSQL and Redis backends. Omit for local snapshot-only mode.
# Pass the file explicitly with uvicorn --env-file or the import CLI --env-file.
# RECOMART_DATABASE_URL=postgresql://recomart:YOUR_PASSWORD@127.0.0.1:55432/recomart
# RECOMART_REDIS_URL=redis://:YOUR_PASSWORD@127.0.0.1:56379/0
RECOMART_CACHE_TTL_SECONDS=3600

# Demo backend address. Set in the process environment before launching Streamlit.
# RECOMART_API_URL=http://127.0.0.1:8000

# Docker Compose reads a root-level .env file. See deploy/compose.env.example.
